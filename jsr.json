{
  "$schema": "https://jsr.io/schema/config-file.v1.json",
  "name": "@ismail-elkorchi/css-parser",
  "version": "0.1.1",
  "exports": {
    ".": "./jsr/mod.ts"
  },
  "publish": {
    "include": [
      "src/**/*.ts",
      "src/internal/vendor/csstree/**",
      "jsr/mod.ts",
      "README.md",
      "THIRD_PARTY_NOTICES.md",
      "LICENSE"
    ]
  },
  "exclude": [
    "dist/**",
    "node_modules/**",
    "test/**",
    "reports/**",
    "tmp/**",
    "scripts/**",
    "css-parser-*.tgz"
  ]
}
